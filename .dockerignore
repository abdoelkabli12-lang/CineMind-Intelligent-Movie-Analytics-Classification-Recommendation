# Git
.git/
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
.eggs/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
