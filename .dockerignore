# Virtual environments
venv/
env/
.venv/
ENV/

# Jupyter
.ipynb_checkpoints/

# ML models (keep tracked models, exclude others)
models/*.ckpt
models/*.h5
models/*.keras
models/*.pt
models/*.pth
models/*.onnx
models/*.pb
# Tracked models are kept:
!models/best_pipeline.pkl
!models/best_model.pkl
!models/feature_names.json
!models/target_info.json

# Data (large files - keep small text files)
data/*.csv
data/*.parquet
data/*.json
data/*.h5
data/*.hdf5
data/*.xlsx
!data/data_description.txt

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
*.lnk
$RECYCLE.BIN/

# Build / temp
*.log
*.tmp
tmp/
temp/
*.bak
*.old

# Secrets
.env
.env.*
secrets.*
*.key
*.pem

# Docker (keep these files)
!Dockerfile
!docker-compose.yml
!docker-compose.override.yml
!docker-compose.debug.yml
