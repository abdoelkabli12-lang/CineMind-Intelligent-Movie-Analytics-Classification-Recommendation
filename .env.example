# Copy to .env and fill in real values.
#
# NOTE: your existing .env has a broken structure - real credentials sit on
# bare lines 3 and 4 with no KEY= prefix, so dotenv cannot read them. Rewrite
# the file in the KEY=value format below. Also note MONGODB_URI there points
# at localhost, which cannot work from inside a container.

# TMDB API key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=https://api.themoviedb.org/3

# Password for the MongoDB root user. docker compose refuses to start without
# this value. Use a long random string.
MONGO_ROOT_PASSWORD=abdo2007123

# Defaults are admin / cin-mind if you leave these unset.
MONGO_ROOT_USER=admin
MONGO_DB_NAME=cin-mind

# Do NOT put MONGODB_URI here. docker-compose.yml builds it from the values
# above and injects it, so the host resolves to the `mongo` service.
